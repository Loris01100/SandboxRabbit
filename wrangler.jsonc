{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sandbox-rabbit",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sandbox-rabbit",
			"database_id": "53b73e19-0d85-4d81-8357-241913ff60d5"
		}
	],
	// Limite de débit sur l'écriture : 20 requêtes par IP et par minute.
	// Compteur géré par Cloudflare, rien à stocker.
	"unsafe": {
		"bindings": [
			{
				"name": "RL",
				"type": "ratelimit",
				"namespace_id": "1",
				"simple": {
					"limit": 20,
					"period": 60
				}
			}
		]
	}
}
