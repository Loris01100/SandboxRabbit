{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sandbox-rabbit",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sandbox-rabbit",
			"database_id": "53b73e19-0d85-4d81-8357-241913ff60d5"
		}
	],
	// IA : aucun setup, juste le binding
	"ai": {
		"binding": "AI"
	}
}
