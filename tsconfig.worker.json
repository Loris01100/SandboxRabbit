{
  // Côté Worker : types runtime générés par `npm run cf-typegen`, pas de DOM.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports en `.ts` : Node exécute test/api.ts sans build.
    "allowImportingTsExtensions": true,
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src/worker", "worker-configuration.d.ts"]
}
