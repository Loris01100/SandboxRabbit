{
  "name": "sandbox-rabbit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "check": "node test/sim.ts && node test/ui.ts && node test/api.ts",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "bench": "node test/bench.ts",
    "loc": "node test/loc.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "allowScripts": {
    "workerd@1.20260811.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
